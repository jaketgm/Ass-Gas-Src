# API Configuration
SOLANA_API_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT=30000
PORT=3001
API_VERSION=v1

# Token Configuration
TOKEN_MINT_ADDRESS=TokenAddressGoesHere
MIN_TOKEN_AMOUNT=1000000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=airdrop_user
DB_PASSWORD=secure_db_password
DB_NAME=airdrop_db

# Security Settings
JWT_SECRET=change_this_to_a_secure_random_string
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
SIGNATURE_EXPIRY_MS=300000

